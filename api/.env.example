# ===== Homeland Group — API environment (/app/api/.env) =====
# Copy this file to ".env" on your server and fill in the real values.

# --- Database (MongoDB Atlas for production) ---
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=homeland

# --- Admin login (seeds the admin account on first run) ---
ADMIN_EMAIL=admin@homelandgroup.org
ADMIN_PASSWORD=ChooseAStrongPassword

# --- Security / sessions ---
JWT_SECRET=put-a-long-random-string-here
JWT_EXPIRE_MINUTES=1440

# --- Server host/port (Node binds to this; Nginx/Hostinger proxies to it) ---
PORT=8001

# --- AI assistant + website chatbot + AI design (Emergent universal key) ---
# Powers the chatbot and admin AI design. Replaceable with your own key setup later.
EMERGENT_LLM_KEY=sk-emergent-xxxxxxxxxxxxxxxx

# --- Site-visit reminder emails (Emergent Managed Email / Resend) ---
# Provisioned by Emergent; paste the real value on the server (never commit it).
EMERGENT_EMAIL_KEY=ek_xxxxxxxxxxxxxxxx
EMAIL_FROM_NAME=Homeland Group
# Inbox that receives the morning site-visit reminders (your sales team/admin).
REMINDER_EMAIL=sales@yourdomain.com
# Timezone used for the 7am reminder schedule.
REMINDER_TZ=Asia/Kolkata

# NOTE: Emergent Google sign-in needs NO key — it uses Emergent's managed auth URLs.
